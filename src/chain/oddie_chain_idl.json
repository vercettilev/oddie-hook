  "types": [
    {
      "name": "Market",
      "docs": [
        "A single binary (YES/NO) pari-mutuel prediction market.",
        "",
        "All staked SOL lives in the associated [`Vault`] PDA, not in this account.",
        "`total_yes` / `total_no` track the escrowed pools so payouts can be computed",
        "without iterating positions."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "docs": [
              "Admin authority fixed at creation; the only key allowed to resolve."
            ],
            "type": "pubkey"
          },
          {
            "name": "market_id",
            "docs": [
              "Caller-supplied nonce making the market PDA unique per authority."
            ],
            "type": "u64"
          },
          {
            "name": "question",
            "docs": [
              "Human-readable question, e.g. \"Will SOL close above $200 on 2026-08-01?\"."
            ],
            "type": "string"
          },
          {
            "name": "close_time",
            "docs": [
              "Unix timestamp after which no new positions are accepted."
            ],
            "type": "i64"
          },
          {
            "name": "resolved",
            "docs": [
              "True once the authority has resolved the outcome."
            ],
            "type": "bool"
          },
          {
            "name": "winning_side",
            "docs": [
              "Winning side (0 = YES, 1 = NO); only meaningful when `resolved`."
            ],
            "type": "u8"
          },
          {
            "name": "total_yes",
            "docs": [
              "Total lamports staked on YES."
            ],
            "type": "u64"
          },
          {
            "name": "total_no",
            "docs": [
              "Total lamports staked on NO."
            ],
            "type": "u64"
          },
          {
            "name": "bump",
            "docs": [
              "Bump for the market PDA."
            ],
            "type": "u8"
          },
          {
            "name": "vault_bump",
            "docs": [
              "Bump for the vault PDA."
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Position",
      "docs": [
        "One bettor's stake in one market. A wallet holds at most one position per",
        "market; repeated `take_position` calls accumulate on the same side."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "docs": [
              "The market this position belongs to."
            ],
            "type": "pubkey"
          },
          {
            "name": "owner",
            "docs": [
              "The wallet that owns (and can claim) this position."
            ],
            "type": "pubkey"
          },
          {
            "name": "side",
            "docs": [
              "Chosen side (0 = YES, 1 = NO)."
            ],
            "type": "u8"
          },
          {
            "name": "amount",
            "docs": [
              "Total lamports this wallet has staked."
            ],
            "type": "u64"
          },
          {
            "name": "claimed",
            "docs": [
              "True once winnings have been claimed."
            ],
            "type": "bool"
          },
          {
            "name": "bump",
            "docs": [
              "Bump for the position PDA."
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "Vault",
      "docs": [
        "Program-owned native SOL escrow for a single market.",
        "",
        "Holds its own rent-exempt reserve plus every lamport staked via",
        "`take_position`. Payouts are debited directly (the program owns it), so no",
        "`invoke_signed` is required on the withdrawal path."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market",
            "docs": [
              "The market this vault escrows for."
            ],
            "type": "pubkey"
          },
          {
            "name": "bump",
            "docs": [
              "Bump for the vault PDA."
            ],
            "type": "u8"
          }
        ]
      }
    }
  ],
